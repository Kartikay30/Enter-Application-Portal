# =============================================
# .env.example - Environment Variables Template
# =============================================
# Copy this file and rename it to .env
# These are SECRET settings your app needs to run
# =============================================

# A random secret key used to sign JWT tokens (change this in production!)
SECRET_KEY=your-super-secret-key-change-this

# How long a login token stays valid (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database file path (SQLite stores data in a single file)
DATABASE_URL=sqlite:///./hiring.db

# Default admin credentials (used by seed script on first run)
ADMIN_EMAIL=admin@enter.in
ADMIN_PASSWORD=admin123
